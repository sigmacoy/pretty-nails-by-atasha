generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  nickname      String?
  password      String?
  image         String?
  role          String    @default("CUSTOMER")
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  bookings       Booking[]
  loyaltyCard    LoyaltyCard?
  notes          CustomerNote[]      @relation("CustomerNotes")
  adminNotes     CustomerNote[]      @relation("AdminNotes")
  payments       Payment[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Service {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String   // GEL, EXTENSION, PEDICURE, ADDON
  description String?
  basePrice   Int      // in centavos (PHP * 100)
  duration    Int      // in minutes
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants    ServiceVariant[]
  bookings    BookingService[]

  @@map("services")
}

model ServiceVariant {
  id        String   @id @default(cuid())
  serviceId String
  name      String   // SMALL, MEDIUM, LONG
  price     Int      // in centavos
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_variants")
}

model Booking {
  id              String   @id @default(cuid())
  userId          String
  status          String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  appointmentDate DateTime
  startTime       String   // HH:mm format
  endTime         String   // HH:mm format
  totalPrice      Int      // in centavos
  downpayment     Int      @default(10000) // 100 PHP in centavos
  notes           String?  // Customer notes/inspiration
  inspirationImg  String?  // URL to uploaded image
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  services        BookingService[]
  payment         Payment?
  loyaltyStamps   LoyaltyStamp[]

  @@map("bookings")
}

model BookingService {
  id           String  @id @default(cuid())
  bookingId    String
  serviceId    String
  variantId    String?
  quantity     Int     @default(1)
  price        Int     // in centavos
  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("booking_services")
}

model Payment {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  userId       String
  amount       Int      // in centavos
  status       String   @default("PENDING") // PENDING, PAID, REFUNDED, FORFEITED
  method       String   // GCASH
  reference    String?  // GCash reference number
  verifiedAt   DateTime?
  verifiedBy   String?  // Admin user ID
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model LoyaltyCard {
  id            String   @id @default(cuid())
  userId        String   @unique
  stampCount    Int      @default(0)
  lastStampAt   DateTime?
  expiresAt     DateTime // 12 months from last stamp
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stamps        LoyaltyStamp[]

  @@map("loyalty_cards")
}

model LoyaltyStamp {
  id        String   @id @default(cuid())
  cardId    String
  bookingId String?
  earnedAt  DateTime @default(now())
  source    String   // SERVICE or AMOUNT
  amount    Int?     // If earned by amount

  card      LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  booking   Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@map("loyalty_stamps")
}

model Availability {
  id          String   @id @default(cuid())
  date        DateTime // Changed from @db.Date
  isAvailable Boolean  @default(true)
  startTime   String   @default("08:00") // HH:mm
  endTime     String   @default("22:00") // HH:mm
  maxSlots    Int      @default(4)
  note        String?  // Reason for blocking
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date])
  @@map("availabilities")
}

model Gallery {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  category    String?  // GEL, EXTENSION, PEDICURE, NAIL_ART
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("gallery")
}

model CustomerNote {
  id        String   @id @default(cuid())
  userId    String
  adminId   String
  content   String   // Removed @db.Text
  nickname  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("CustomerNotes", fields: [userId], references: [id], onDelete: Cascade)
  admin     User     @relation("AdminNotes", fields: [adminId], references: [id], onDelete: Cascade)

  @@map("customer_notes")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}